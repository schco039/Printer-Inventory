# Kartenleser-Dienst als systemd-Einheit (Raspberry Pi / Linux).
#
#   sudo apt install pcscd python3-pyscard
#   sudo cp tools/lgk-badge-agent.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/lgk-badge-agent.service   ← Adresse und Token
#   sudo systemctl enable --now lgk-badge-agent
#   systemctl status lgk-badge-agent

[Unit]
Description=Lecteur de badges pour la gestion des consommables
After=network-online.target pcscd.service
Wants=network-online.target pcscd.service

[Service]
Type=simple
User=pi
ExecStart=/usr/bin/python3 /opt/lgk-printer/tools/badge_agent.py \
    --server http://SERVER:8080 \
    --token TOKEN_AUS_DER_ENV_DATEI \
    --station kiosk
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

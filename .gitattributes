# Zeilenenden festnageln.
# Ohne das bekommen install.sh und entrypoint.sh unter Windows CRLF und
# scheitern auf dem Linux-Server mit "bad interpreter: /bin/sh^M".
* text=auto eol=lf

*.sh        text eol=lf
Dockerfile  text eol=lf
*.ps1       text eol=crlf

*.xlsx binary
*.xlsm binary
*.png  binary

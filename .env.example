# Wird von install.sh / install.ps1 automatisch als .env erzeugt.
# Diese Datei ist die Vorlage und enthält KEINE echten Geheimnisse.

# Port, unter dem die Anwendung im LAN erreichbar ist
APP_PORT=8080

# Secret für Badge-HMAC und Sessions — wird beim Install zufällig erzeugt.
# Achtung: wird dieser Wert später geändert, passen die gespeicherten
# Badge-Hashes nicht mehr und alle Badges müssen neu angelernt werden.
APP_SECRET=

# Zugang zur Admin-Oberfläche (Übergangslösung bis M4)
ADMIN_USER=admin
ADMIN_PASSWORD=

TZ=Europe/Luxembourg
DEFAULT_LOCALE=fr

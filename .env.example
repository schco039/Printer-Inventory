# Wird von install.sh / install.ps1 automatisch als .env erzeugt.
# Diese Datei ist die Vorlage und enthält KEINE echten Geheimnisse.

# Port, unter dem die Anwendung im LAN erreichbar ist.
# Auf einem Docker-Host mit weiteren Diensten hier einen freien Port wählen.
APP_PORT=8080

# Nur nötig, wenn auf dem Host schon ein Container "lgk-printer" heißt
CONTAINER_NAME=lgk-printer

# Schlüssel für die Anmelde-Sitzungen — wird beim Install zufällig erzeugt.
# Wird er geändert, sind alle offenen Sitzungen ungültig und man muss sich
# neu anmelden. Die PIN-Codes selbst bleiben davon unberührt.
APP_SECRET=

TZ=Europe/Luxembourg
DEFAULT_LOCALE=fr

# Tägliche Sicherung der Datenbank nach data/backups (02:00 Uhr, 14 Tage).
# Ersetzt kein externes Backup — ./data gehört zusätzlich in die Serversicherung.
BACKUP_ENABLED=true

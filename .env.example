# Wird von install.sh / install.ps1 automatisch als .env erzeugt.
# Diese Datei ist die Vorlage und enthält KEINE echten Geheimnisse.

# Port, unter dem die Anwendung im LAN erreichbar ist.
# Auf einem Docker-Host mit weiteren Diensten hier einen freien Port wählen.
APP_PORT=8080

# Nur nötig, wenn auf dem Host schon ein Container "lgk-printer" heißt
CONTAINER_NAME=lgk-printer

# Secret für Badge-HMAC und Sessions — wird beim Install zufällig erzeugt.
# Achtung: wird dieser Wert später geändert, passen die gespeicherten
# Badge-Hashes nicht mehr und alle Badges müssen neu angelernt werden.
APP_SECRET=

# Zugang zur Admin-Oberfläche
ADMIN_USER=admin
ADMIN_PASSWORD=

# Gemeinsames Geheimnis für den Kartenleser-Dienst (tools/badge_agent.py).
# Wird beim Install zufällig erzeugt. Denselben Wert beim Dienst als --token
# angeben. Leer = die Leser-Schnittstelle ist abgeschaltet.
BADGE_AGENT_TOKEN=

TZ=Europe/Luxembourg
DEFAULT_LOCALE=fr

# Tägliche Sicherung der Datenbank nach data/backups (02:00 Uhr, 14 Tage).
# Ersetzt kein externes Backup — ./data gehört zusätzlich in die Serversicherung.
BACKUP_ENABLED=true
